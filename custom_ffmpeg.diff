+    x86_reg tmp;
+    __asm__ volatile(
+        "movl        %c5(%1), %k0       \n\t"
+        "movl        %c2(%1), %%eax     \n\t"
+        "shl             $17, %k0       \n\t"
+        "add           %%eax, %%eax     \n\t"
+        "sub             %k0, %%eax     \n\t"
+        "cdq                            \n\t"
+        "and           %%edx, %k0       \n\t"
+        "add             %k0, %%eax     \n\t"
+        /* No "inc %edx" — return value is discarded by caller. */
+        "test           %%ax, %%ax      \n\t"
+        "jnz              1f            \n\t"
+        "mov         %c3(%1), %0        \n\t"
+        "subl        $0xFFFF, %%eax     \n\t"
+        "movzwl         (%0), %%ecx     \n\t"
+        "bswap         %%ecx            \n\t"
+        "shrl            $15, %%ecx     \n\t"
+        "addl          %%ecx, %%eax     \n\t"
+        "cmp         %c4(%1), %0        \n\t"
+        "jge              1f            \n\t"
+        "add"FF_OPSIZE"   $2, %c3(%1)   \n\t"
+        "1:                             \n\t"
+        "movl          %%eax, %c2(%1)   \n\t"
