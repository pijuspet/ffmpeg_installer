+static av_always_inline void decode_cabac_residual_dc_skip(const H264Context *h,
+                                                      H264SliceContext *sl,
+                                                      int cat, int n,
+                                                      const uint8_t *scantable,
+                                                      int max_coeff)
+{
+    /* read coded block flag */
